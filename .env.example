# Copie este arquivo para .env e preencha os valores

# Segredo JWT - TROQUE por uma string aleatória longa e segura
JWT_SECRET=troque-por-uma-chave-secreta-muito-longa-aqui-2025

# Caminho do banco de dados (Railway preenche automaticamente via volume)
# RAILWAY_VOLUME_MOUNT_PATH=/data  <- Railway define isso automaticamente
# DATABASE_PATH=/data/templo-uno-erp.db  <- opcional, Railway resolve sozinho

# Ambiente
NODE_ENV=production
